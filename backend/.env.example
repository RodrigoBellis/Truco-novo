PORT=3001

# Supabase — configure seu projeto de desenvolvimento/homologação.
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# service_role — NUNCA commitar, NUNCA expor ao frontend. Pegue em:
# Supabase Dashboard > Project Settings > API > service_role secret key.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Senha temporária das contas provisionadas; substitua por um valor seguro localmente.
TRUCO_DEFAULT_PASSWORD=sua-senha-temporaria-aqui
